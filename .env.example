# Example environment variables required to run Trade Arena

# Payout and blockchain
PAYOUT_PRIVATE_KEY=
ALCHEMY_API_KEY=
RPC_URL=
PAYOUT_MANAGER_ADDRESS=
REWARD_TOKEN_ADDRESS=
CHAIN_ID=8453

# AI / Model access (do NOT store real keys in repo)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Auth / Webhooks
TASK_CLAIM_SECRET=
MOONPAY_WEBHOOK_SECRET=
MM_CLI_TOKEN=
PRIVY_APP_ID=
GOOGLE_CLIENT_ID=
ADMIN_API_KEY=

# App config
ALLOWED_ORIGIN=
ENABLE_LIVE_EXECUTION=false
ARB_MIN_PROFIT_USD=5
ARB_MAX_GAS_USD=2

# Notes:
# - Copy this file to .env locally or set environment variables in your hosting provider.
# - Never commit real secret values to the repository.
