# Trade Arena Backend Environment Variables
# Copy this file to .env for local development

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database/Storage
# DATABASE_URL=postgresql://username:password@localhost:5432/tradearena

# API Keys
COIN_GECKO_API_KEY=your_coingecko_api_key_here
MOONPAY_API_KEY=your_moonpay_api_key_here
PRIVEY_APP_ID=your_privey_app_id_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Blockchain Configuration
RPC_URL=https://mainnet.base.org
AAVE_FLASH_LOAN_ADDRESS=0x794a61358D6845594F94dc1DB02A252b5b4814aD
UNISWAP_V3_ADDRESS=0x68b3465833fb72B5A828cCEA02FFAD6bCFB8ACCA

# Security
MOONPAY_WEBHOOK_SECRET=your_moonpay_webhook_secret_here
SESSION_SECRET=your_session_secret_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/tradearena.log

# CORS
CORS_ORIGIN=http://localhost:3000