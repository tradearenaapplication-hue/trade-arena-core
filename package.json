{
  "name": "trade-arena",
  "version": "4.0.0",
  "description": "Multi-AI Trading Arena with Ridges Integration",
  "main": "server.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm run proxy\" \"npm run start\"",
    "proxy": "node proxy.js",
    "serve": "npx serve .",
    "test": "node tests.js",
    "test:wallet": "node scripts/wallet-integration-test.js",
    "wallet:setup": "node mm-wallet-setup.js",
    "wallet:check": "mm doctor --json",
    "wallet:balances": "mm wallet balance --chain-ids 8453,42161,10 --json",
    "wallet:address": "mm wallet address --json",
    "wallet:auth": "mm login browser --no-wait"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "body-parser": "^1.20.6",
    "ccxt": "^4.2.77",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "qs": "^6.16.0",
    "shell-quote": "^1.9.0",
    "websocket": "^1.0.35"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "overrides": {
    "qs": "^6.16.0",
    "body-parser": "^1.20.6",
    "shell-quote": "^1.9.0"
  },
  "pnpm": {
    "overrides": {
      "qs": "^6.16.0",
      "body-parser": "^1.20.6",
      "shell-quote": "^1.9.0"
    }
  }
}