{
  "name": "trade-arena",
  "version": "4.0.0",
  "description": "Multi-AI Trading Arena with Ridges Integration",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm run proxy\" \"npm run start\"",
    "proxy": "node proxy.js",
    "serve": "npx serve .",
    "test": "node tests.js",
    "test:contract": "cd contracts && forge test",
    "test:all": "npm run test:contract && npm run test:executor && npm test",
    "build:contract": "cd contracts && forge build",
    "chain:sepolia": "cd contracts && anvil --fork-url https://sepolia.base.org --fork-chain-id 84532 --fork-block-number 47571694 --port 8545",
    "deploy:sepolia": "cd contracts && forge script script/DeploySepolia.s.sol:DeploySepolia --rpc-url https://sepolia.base.org --broadcast --slow",
    "deploy:sepolia:dry": "cd contracts && forge script script/DeploySepolia.s.sol:DeploySepolia --rpc-url https://sepolia.base.org",
    "test:crucible": "node scripts/verify-crucible-regime.js",
    "test:executor": "node scripts/test-funding-executor.js",
    "scan:flash": "node scripts/scan-flashloan-arb.js",
    "test:detection": "node scripts/test-scanner-detection.js",
    "test:failover": "node scripts/test-rpc-failover.js",
    "scan:flash:record": "node scripts/scan-flashloan-arb.js --record",
    "scans:summary": "node scripts/query-scans.js summary",
    "scans:coverage": "node scripts/query-scans.js coverage",
    "scans:pairs": "node scripts/query-scans.js by-pair",
    "cache:prime": "node scripts/prime-candle-cache.js",
    "research:edge": "node scripts/search-regime-edge.js",
    "research:cost": "node scripts/cost-sensitivity.js",
    "test:wallet": "node scripts/wallet-integration-test.js",
    "preflight:live": "node scripts/preflight-live-trading.js",
    "wallet:setup": "node mm-wallet-setup.js",
    "wallet:check": "mm doctor --json",
    "wallet:balances": "mm wallet balance --chain-ids 8453,42161,10 --json",
    "wallet:address": "mm wallet address --json",
    "wallet:auth": "mm login browser --no-wait",
    "test:ui": "node scripts/test-ui.js",
    "test:currency": "node scripts/test-currency.js"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "body-parser": "^1.20.6",
    "ccxt": "^4.2.77",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "qs": "^6.16.0",
    "shell-quote": "^1.9.0",
    "websocket": "^1.0.35"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "overrides": {
    "qs": "^6.16.0",
    "body-parser": "^1.20.6",
    "shell-quote": "^1.9.0"
  },
  "pnpm": {
    "overrides": {
      "qs": "^6.16.0",
      "body-parser": "^1.20.6",
      "shell-quote": "^1.9.0"
    }
  }
}
